rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Required by Firebase Skill connection test on app boot
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    match /accounts/{usernameId} {
      allow get: if isValidId(usernameId);
      allow list: if false;
      allow create, update: if isValidId(usernameId) &&
        incoming().usernameId is string &&
        incoming().usernameId == usernameId;
      allow delete: if false;
    }

    match /rooms/{roomCode} {
      allow get: if isValidId(roomCode);
      allow list: if true;
      allow create, update: if isValidId(roomCode) &&
        incoming().roomCode is string &&
        incoming().roomCode == roomCode;
      allow delete: if false;

      match /members/{memberId} {
        allow get: if isValidId(roomCode) && isValidId(memberId);
        allow list: if isValidId(roomCode);
        allow create, update: if isValidId(roomCode) &&
          isValidId(memberId) &&
          incoming().roomCode is string &&
          incoming().roomCode == roomCode;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow get: if isValidId(roomCode) && isValidId(messageId);
        allow list: if isValidId(roomCode);
        allow create: if isValidId(roomCode) &&
          isValidId(messageId) &&
          incoming().text is string &&
          incoming().text.size() >= 1 &&
          incoming().text.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}
